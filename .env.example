# Copiez ce fichier en .env et remplacez les placeholders. Ne commitez jamais .env.
# Valeurs PUBLIQUES uniquement (EXPO_PUBLIC_* est embarqué dans l'app).
# Aucune clé secrète, aucun chemin .p8, aucune clé ASC.

EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# API optionnelle, Phase 2. L'application ne l'appelle pas au démarrage.
EXPO_PUBLIC_API_BASE_URL=YOUR_API_BASE_URL

# Build iOS : ne pas synchroniser les capabilities (conservé, aucun build dans cette passe).
EXPO_NO_CAPABILITY_SYNC=1

# Côté SERVEUR uniquement — jamais en EXPO_PUBLIC_, jamais dans l'app. Phase 2.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# PORT=YOUR_PORT

# Décisions de Mohamed — à valider. Ne pas inventer de valeur.
# YOUR_REPORTING_CURRENCY
# YOUR_CONSOLIDATION_GAAP
# YOUR_LEGAL_STRUCTURE
# YOUR_DATA_REGION
# YOUR_FX_RATE_SOURCE
# YOUR_BUDGET_ALERT_PCT
# YOUR_ESIGN_PROVIDER
# YOUR_ARMORED_PERMITS
# YOUR_REVIEW_ACCOUNT
# YOUR_SUPPORT_EMAIL

# Flags Phase 2, forcés à false dans l'application (chemin critique sans API payante).
# FEATURE_AI=false
# FEATURE_BANK_SYNC=false
# FEATURE_ESIGN=false
# FEATURE_PUSH=false
