# Copiez ce fichier en .env et remplacez les placeholders. Ne commitez jamais .env.
# Valeurs PUBLIQUES uniquement (EXPO_PUBLIC_* est embarqué dans l'app).
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_API_BASE_URL=YOUR_API_BASE_URL

# Côté SERVEUR uniquement (jamais dans l'app, jamais en EXPO_PUBLIC_) — Phase 2 :
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# PORT=3000
